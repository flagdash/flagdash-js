{
  "name": "@flagdashio/vue",
  "version": "0.1.0",
  "description": "FlagDash Vue 3 SDK for feature flags, remote config, AI configs, translations, and experiments",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./replay": {
      "types": "./dist/replay.d.ts",
      "import": "./dist/replay.js",
      "require": "./dist/replay.cjs"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts src/replay.ts --format cjs,esm --dts --external vue",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external vue --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": ["flagdash", "vue", "feature-flags", "remote-config", "experiments"],
  "license": "MIT",
  "author": "FlagDash <support@flagdash.com>",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "https://github.com/flagdash/flagdash-js.git",
    "directory": "packages/vue"
  },
  "homepage": "https://flagdash.com/docs",
  "bugs": { "url": "https://github.com/flagdash/flagdash-js/issues" },
  "peerDependencies": { "vue": ">=3.3.0" },
  "dependencies": { "@flagdashio/sdk": "workspace:*" },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^28.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "vue": "^3.5.0"
  }
}
